#!/bin/zsh

SCRIPT_PATH="${0:A}"
PROXY_DIR="${SCRIPT_PATH:h:h}"
START_SCRIPT="$PROXY_DIR/start.sh"
PID_FILE="/tmp/agentrouter-opencode-proxy.pid"
LOG_FILE="/tmp/agentrouter-opencode-proxy.log"
TRAY_PID_FILE="/tmp/agentrouter-opencode-proxy-tray.pid"
TRAY_SRC="$PROXY_DIR/tray.swift"
TRAY_BIN="$PROXY_DIR/.tray/agentrouter-tray"

KEY_DIR="$HOME/.config/opencode/api_keys"
QUOTA_USER_ID_FILE="$KEY_DIR/AGENT_ROUTER_USER_ID"
QUOTA_COOKIE_FILE="$KEY_DIR/AGENT_ROUTER_COOKIE"

POOL_FILE="$KEY_DIR/pool.json"
POOL_STATE_FILE="$KEY_DIR/pool-state.json"
POOL_KEY_PREFIX="AGENTROUTER_FRIEND_"
POOL_TARGET="${AGENTROUTER_TARGET:-https://agentrouter.org}"
PROXY_URL="${AGENTROUTER_PROXY_URL:-http://localhost:7187}"
VENV_PY="$PROXY_DIR/.venv/bin/python"

TRAY_INTERVAL="${AGENTROUTER_TRAY_INTERVAL:-120}"

is_running() {
    [[ -f "$PID_FILE" ]] || return 1
    local pid
    pid=$(cat "$PID_FILE" 2>/dev/null)
    [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null
}

tray_is_running() {
    [[ -f "$TRAY_PID_FILE" ]] || return 1
    local pid
    pid=$(cat "$TRAY_PID_FILE" 2>/dev/null)
    [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null
}

ensure_tray_built() {
    if [[ -x "$TRAY_BIN" ]] && [[ "$TRAY_SRC" -ot "$TRAY_BIN" ]]; then
        return 0
    fi

    if [[ ! -f "$TRAY_SRC" ]]; then
        echo "tray.swift not found at $TRAY_SRC"
        return 1
    fi

    mkdir -p "$(dirname "$TRAY_BIN")"
    swiftc -O "$TRAY_SRC" -o "$TRAY_BIN" -framework Cocoa 2>/dev/null

    if [[ ! -x "$TRAY_BIN" ]]; then
        echo "Failed to compile tray app"
        return 1
    fi
}

start_tray() {
    if tray_is_running; then
        return 0
    fi

    ensure_tray_built || return 1

    AGENTROUTER_PROXY="$SCRIPT_PATH" \
    AGENTROUTER_TRAY_INTERVAL="$TRAY_INTERVAL" \
        nohup "$TRAY_BIN" > /dev/null 2>&1 &
    echo $! > "$TRAY_PID_FILE"

    sleep 0.5
    if ! tray_is_running; then
        rm -f "$TRAY_PID_FILE"
        return 1
    fi
}

stop_tray() {
    if ! tray_is_running; then
        rm -f "$TRAY_PID_FILE"
        return 0
    fi

    local pid
    pid=$(cat "$TRAY_PID_FILE")
    kill "$pid" 2>/dev/null

    for _ in {1..20}; do
        if ! kill -0 "$pid" 2>/dev/null; then
            break
        fi
        sleep 0.1
    done

    if kill -0 "$pid" 2>/dev/null; then
        kill -9 "$pid" 2>/dev/null
    fi

    rm -f "$TRAY_PID_FILE"
}

fetch_quota() {
    local user_id="" cookie=""
    if [[ -f "$QUOTA_USER_ID_FILE" ]]; then
        user_id=$(cat "$QUOTA_USER_ID_FILE" 2>/dev/null | tr -d '\n')
    fi
    if [[ -f "$QUOTA_COOKIE_FILE" ]]; then
        cookie=$(cat "$QUOTA_COOKIE_FILE" 2>/dev/null | tr -d '\n')
    fi

    if [[ -z "$user_id" || -z "$cookie" ]]; then
        echo '{"error":"missing credentials","hint":"run: agentrouter-proxy set-cookie"}'
        return 1
    fi

    curl -s --max-time 5 \
        'https://agentrouter.org/api/user/self' \
        -H "New-API-User: $user_id" \
        -b "$cookie" 2>/dev/null
}

quota_report() {
    local raw=false
    [[ "$1" == "--raw" ]] && raw=true

    local resp
    resp=$(fetch_quota) || {
        if $raw; then
            echo '{"error":"failed to fetch quota"}'
        else
            echo "Failed to fetch quota — check your cookie/credentials."
            echo "  agentrouter-proxy set-cookie"
        fi
        return 1
    }

    local ok
    ok=$(echo "$resp" | jq -r '.success' 2>/dev/null)
    if [[ "$ok" != "true" ]]; then
        if $raw; then
            echo "$resp"
        else
            echo "Quota API returned an error:"
            echo "$resp" | jq '.' 2>/dev/null || echo "$resp"
            echo ""
            echo "Your session cookie may have expired. Refresh with:"
            echo "  agentrouter-proxy set-cookie"
        fi
        return 1
    fi

    if $raw; then
        echo "$resp" | jq '.data | {quota, used_quota, request_count, id, username}' 2>/dev/null
    else
        local quota used total pct dollars used_dollars total_dollars reqs
        quota=$(echo "$resp" | jq '.data.quota' 2>/dev/null)
        used=$(echo "$resp" | jq '.data.used_quota' 2>/dev/null)
        reqs=$(echo "$resp" | jq '.data.request_count' 2>/dev/null)
        total=$((quota + used))
        if (( total > 0 )); then
            pct=$(awk "BEGIN{printf \"%.1f\", $quota/$total*100}")
            dollars=$(awk "BEGIN{printf \"%.2f\", $quota/500000}")
            used_dollars=$(awk "BEGIN{printf \"%.2f\", $used/500000}")
            total_dollars=$(awk "BEGIN{printf \"%.2f\", $total/500000}")
        else
            pct="0.0"
            dollars="0.00"
            used_dollars="0.00"
            total_dollars="0.00"
        fi
        echo "Quota remaining: ${pct}% (\$${dollars} of \$${total_dollars} used)"
        echo "  Used: \$${used_dollars}  Requests: ${reqs}"
    fi
}

set_cookie() {
    local user_id="" cookie=""

    if [[ -f "$QUOTA_USER_ID_FILE" ]]; then
        user_id=$(cat "$QUOTA_USER_ID_FILE" 2>/dev/null | tr -d '\n')
    fi

    echo "Paste your New-API-User id (current: ${user_id:-none}):"
    read -r new_id
    if [[ -n "$new_id" ]]; then
        echo "$new_id" > "$QUOTA_USER_ID_FILE"
        chmod 600 "$QUOTA_USER_ID_FILE"
        user_id="$new_id"
        echo "Saved user id."
    fi

    echo "Paste your session cookie (current: ${cookie:+set}):"
    read -r new_cookie
    if [[ -n "$new_cookie" ]]; then
        echo "$new_cookie" > "$QUOTA_COOKIE_FILE"
        chmod 600 "$QUOTA_COOKIE_FILE"
        cookie="$new_cookie"
        echo "Saved cookie."
    fi

    if [[ -n "$user_id" && -n "$cookie" ]]; then
        echo ""
        echo "Testing..."
        quota_report
    else
        echo "Both user id and cookie are needed."
        return 1
    fi
}

fetch_models() {
    # Print live AgentRouter model ids, one per line.
    # Tries the dashboard API first (same credentials as quota),
    # falls back to the running local proxy (TTL cache + stub fallback).
    local user_id="" cookie=""
    if [[ -f "$QUOTA_USER_ID_FILE" ]]; then
        user_id=$(cat "$QUOTA_USER_ID_FILE" 2>/dev/null | tr -d '\n')
    fi
    if [[ -f "$QUOTA_COOKIE_FILE" ]]; then
        cookie=$(cat "$QUOTA_COOKIE_FILE" 2>/dev/null | tr -d '\n')
    fi

    if [[ -n "$user_id" && -n "$cookie" ]]; then
        local resp names
        resp=$(curl -s --max-time 30 \
            'https://agentrouter.org/api/user/models' \
            -H "New-API-User: $user_id" \
            -b "$cookie" \
            -H 'Accept: application/json' 2>/dev/null)
        names=$(echo "$resp" | jq -r '.data[]? | select(type=="string")' 2>/dev/null)
        if [[ -n "$names" ]]; then
            echo "$names"
            return 0
        fi
    fi

    local proxied
    proxied=$(curl -s --max-time 15 'http://localhost:7187/v1/models' 2>/dev/null \
        | jq -r '.data[]?.id' 2>/dev/null)
    if [[ -n "$proxied" ]]; then
        echo "$proxied"
        return 0
    fi

    return 1
}

sync_models() {
    # Rewrite the `models` block of every opencode.json provider that
    # points at this proxy, so the TUI picker matches the live upstream
    # list. The TUI reads models from config — it never queries /v1/models.
    local dry_run=false config="$HOME/.config/opencode/opencode.json"

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -n|--dry-run) dry_run=true; shift ;;
            -c|--config) config="$2"; shift 2 ;;
            *) echo "Unknown option: $1"
               echo "Usage: agentrouter-proxy sync-models [-n|--dry-run] [-c|--config PATH]"
               return 1 ;;
        esac
    done

    if [[ ! -f "$config" ]]; then
        echo "Config not found: $config"
        return 1
    fi
    if ! command -v jq >/dev/null 2>&1; then
        echo "jq is required for sync-models."
        return 1
    fi
    if ! command -v python3 >/dev/null 2>&1; then
        echo "python3 is required for sync-models."
        return 1
    fi

    echo "Fetching live model list..."
    local names
    names=$(fetch_models) || {
        echo "Failed to fetch model list from dashboard and local proxy."
        echo "  agentrouter-proxy set-cookie   # refresh dashboard credentials"
        return 1
    }

    local count
    count=$(echo "$names" | grep -c .)
    echo "Live models ($count): $(echo "$names" | tr '\n' ' ')"

    if $dry_run; then
        echo "Dry run — $config unchanged."
        return 0
    fi

    cp "$config" "$config.bak" || { echo "Backup failed; aborting."; return 1; }

    echo "$names" | python3 -c '
import json, sys
config_path = sys.argv[1]
names = [l.strip() for l in sys.stdin if l.strip()]
with open(config_path) as f:
    cfg = json.load(f)
providers = cfg.get("provider", {})
touched = []
for key, prov in providers.items():
    base = ((prov.get("options") or {}).get("baseURL") or "")
    if "7187" not in base and "localhost" not in base:
        continue
    old = prov.get("models") or {}
    new_models = {}
    for mid in names:
        if mid in old and isinstance(old[mid], dict) and old[mid].get("name"):
            new_models[mid] = {"name": old[mid]["name"]}
        else:
            new_models[mid] = {"name": mid}
    added = [m for m in new_models if m not in old]
    removed = [m for m in old if m not in new_models]
    prov["models"] = new_models
    touched.append((key, added, removed))
if not touched:
    print("No provider pointing at the local proxy found; config unchanged.")
    sys.exit(2)
with open(config_path, "w") as f:
    json.dump(cfg, f, indent=2)
    f.write("\n")
for key, added, removed in touched:
    print(f"provider {key}: added={added} removed={removed}")
' "$config" || { echo "Update failed; backup at $config.bak"; return 1; }

    echo "Updated $config (backup: $config.bak). Restart the OpenCode TUI to pick up the new list."
}

# ── Key pool ──────────────────────────────────────────────────────────────────
#
# CLI side of the sk--only pool. Key material is read from stdin only (never
# argv), written 600, and never echoed. pool.json is CLI-owned (enabled +
# balance anchors); the proxy owns pool-state.json (dead marks). See
# docs/pool-operations.md.

ensure_pool_file() {
    if [[ ! -f "$POOL_FILE" ]]; then
        mkdir -p "$KEY_DIR"
        echo '{}' > "$POOL_FILE"
        chmod 600 "$POOL_FILE"
    fi
}

_pool_valid_name() {
    # Reject empty / traversal / unexpected characters before any path use.
    local name="$1"
    [[ -n "$name" && "$name" != *[!A-Za-z0-9._-]* ]]
}

_pool_check_mode() {
    local file="$1" mode
    mode=$(stat -f '%Lp' "$file" 2>/dev/null)
    if [[ -n "$mode" && "$mode" != "600" ]]; then
        echo "Tightening permissions on $(basename "$file") ($mode -> 600)."
        chmod 600 "$file"
    fi
}

_pool_key_material() {
    # Print a key's sk- material to stdout. Never logged.
    local name="$1" file
    if [[ "$name" == "you" ]]; then
        file="${AGENTROUTER_API_KEY_FILE:-$KEY_DIR/AGENT_ROUTER_API_KEY}"
        if [[ -f "$file" ]]; then
            tr -d '[:space:]' < "$file"
        else
            printf '%s' "${AGENTROUTER_API_KEY:-}"
        fi
        return 0
    fi
    file="$KEY_DIR/${POOL_KEY_PREFIX}${name}"
    [[ -f "$file" ]] || return 1
    tr -d '[:space:]' < "$file"
}

_pool_usage_cents() {
    # Read the key from stdin (never argv) and print the account-cumulative
    # spend in cents. Same endpoint the proxy uses.
    "$VENV_PY" -c '
import sys
from datetime import datetime, timezone
import httpx

key = sys.stdin.read().strip()
target = sys.argv[1]
today = datetime.now(timezone.utc).date().isoformat()
resp = httpx.get(
    f"{target}/v1/dashboard/billing/usage",
    params={"start_date": "1970-01-01", "end_date": today},
    headers={"Authorization": f"Bearer {key}", "Accept": "application/json"},
    timeout=30.0,
)
resp.raise_for_status()
print(resp.json()["total_usage"])
' "$POOL_TARGET"
}

pool_add() {
    local name="$1"
    if [[ -z "$name" || "$name" == -* ]]; then
        echo "Usage: agentrouter-proxy pool-add <name>"
        echo ""
        echo "Reads the sk- key from stdin (never argv). Interactive:"
        echo "  agentrouter-proxy pool-add friend-a   # then paste the key"
        echo "Piped:"
        echo "  pool-add friend-a < /secure/one-time-share"
        echo ""
        echo "Afterwards: agentrouter-proxy pool-recalibrate $name <remaining_usd>"
        return 1
    fi

    command -v jq >/dev/null 2>&1 || { echo "jq is required for the pool commands."; return 1; }

    local file="$KEY_DIR/${POOL_KEY_PREFIX}${name}"
    case "$name" in
        you)
            echo "'you' resolves to your existing AGENT_ROUTER_API_KEY; don't pool-add it."
            echo "Use: agentrouter-proxy pool-recalibrate you <remaining_usd>"
            return 1
            ;;
        *[!A-Za-z0-9._-]*|"")
            echo "Key name may only contain letters, digits, dot, underscore, dash."
            return 1
            ;;
    esac
    if [[ -f "$file" ]]; then
        echo "A key named '$name' already exists ($file)."
        echo "Run 'agentrouter-proxy pool-forget $name' first to replace it."
        return 1
    fi

    local key
    if [[ -t 0 ]]; then
        echo "Paste the sk- key for '$name' (hidden), then press Enter:"
        read -rs key
        echo ""
    else
        read -r key
    fi
    key=$(printf '%s' "$key" | tr -d '[:space:]')
    if [[ -z "$key" ]]; then
        echo "No key provided; nothing written."
        return 1
    fi
    if [[ "$key" != sk-* ]]; then
        echo "Warning: key does not start with 'sk-'." >&2
    fi

    mkdir -p "$KEY_DIR"
    ( umask 077; print -r -- "$key" > "$file" )
    chmod 600 "$file"

    ensure_pool_file
    local tmp="${POOL_FILE}.tmp.$$"
    if jq --arg name "$name" \
          '.[$name] = {enabled: true, anchor_remaining_usd: null, anchor_usage_cents: null, recalibrated: null}' \
          "$POOL_FILE" > "$tmp"; then
        chmod 600 "$tmp" && mv "$tmp" "$POOL_FILE"
    else
        rm -f "$tmp"
        echo "Failed to update $POOL_FILE; removing key file."
        rm -f "$file"
        return 1
    fi

    echo "Added '$name' ($file, mode 600)."
    echo "It is excluded from routing until calibrated (routing auto-enables then):"
    echo "  agentrouter-proxy pool-recalibrate $name <remaining_usd>"
}

pool_forget() {
    local name="$1"
    [[ -n "$name" ]] || { echo "Usage: agentrouter-proxy pool-forget <name>"; return 1; }
    _pool_valid_name "$name" || { echo "Invalid key name: $name"; return 1; }
    command -v jq >/dev/null 2>&1 || { echo "jq is required for the pool commands."; return 1; }

    local file="$KEY_DIR/${POOL_KEY_PREFIX}${name}" removed=false
    if [[ -f "$file" ]]; then
        rm -f "$file"
        removed=true
        echo "Removed key file: $file"
    else
        echo "No key file for '$name'."
    fi

    if [[ -f "$POOL_FILE" ]]; then
        local tmp="${POOL_FILE}.tmp.$$"
        if jq --arg name "$name" \
              'if has($name) then .[$name].enabled = false else . end' \
              "$POOL_FILE" > "$tmp"; then
            chmod 600 "$tmp" && mv "$tmp" "$POOL_FILE"
            echo "pool.json: '$name' enabled=false."
        else
            rm -f "$tmp"
            echo "Failed to update $POOL_FILE." >&2
        fi
    fi

    echo "The proxy drops the cached client on the next config reload."
}

pool_recalibrate() {
    local name="$1" amount="$2"
    if [[ -z "$name" || -z "$amount" ]]; then
        echo "Usage: agentrouter-proxy pool-recalibrate <name> <remaining_usd>"
        echo "  e.g. agentrouter-proxy pool-recalibrate friend-a 30.00"
        return 1
    fi
    command -v jq >/dev/null 2>&1 || { echo "jq is required for the pool commands."; return 1; }
    _pool_valid_name "$name" || { echo "Invalid key name: $name"; return 1; }
    if [[ "$amount" != <-> && "$amount" != <->.<-> ]]; then
        echo "Not a number: $amount"
        return 1
    fi

    local file keyfile
    if [[ "$name" == "you" ]]; then
        keyfile="${AGENTROUTER_API_KEY_FILE:-$KEY_DIR/AGENT_ROUTER_API_KEY}"
    else
        keyfile="$KEY_DIR/${POOL_KEY_PREFIX}${name}"
    fi
    local key
    key=$(_pool_key_material "$name") || {
        echo "No key material for '$name'."
        echo "  (run: agentrouter-proxy pool-add $name)"
        return 1
    }
    [[ -n "$key" ]] || { echo "No key material for '$name'."; return 1; }
    [[ -f "$keyfile" ]] && _pool_check_mode "$keyfile"

    echo "Reading live usage for '$name'..."
    local cents
    cents=$(printf '%s' "$key" | _pool_usage_cents) || {
        echo "Failed to read usage from $POOL_TARGET. Nothing written."
        return 1
    }

    ensure_pool_file
    local today tmp
    today=$(date -u +%Y-%m-%d)
    tmp="${POOL_FILE}.tmp.$$"
    if jq --arg name "$name" --argjson amount "$amount" --argjson cents "$cents" --arg date "$today" \
          '.[$name] = ((.[$name] // {}) + {enabled: true, anchor_remaining_usd: $amount, anchor_usage_cents: $cents, recalibrated: $date})' \
          "$POOL_FILE" > "$tmp"; then
        chmod 600 "$tmp" && mv "$tmp" "$POOL_FILE"
    else
        rm -f "$tmp"
        echo "Failed to update $POOL_FILE." >&2
        return 1
    fi

    echo "Anchored '$name': remaining \$$amount at ${cents}c usage on $today."
    echo "Any dead mark older than $today is now cleared."
}

_print_pool_status() {
    echo "$1" | jq -r '
      "Pool: \(.per_key | length) key(s), $" +
      (((.total_remaining // 0) * 100 | round) / 100 | tostring) + " remaining" +
      (if .enabled then "" else "  (routing OFF)" end) +
      (if (.usage_unknown_count // 0) > 0 then "  (\(.usage_unknown_count) usage unknown)" else "" end),
      (.per_key | to_entries[] |
        "  " + .key + "  " +
        (if .value.unanchored then "unanchored (run pool-recalibrate)"
         elif .value.usage_unknown then "usage unknown (not scored)"
         else "remaining $" + ((((.value.remaining // 0) * 100 | round) / 100) | tostring) +
              "  spent $" + ((((.value.spent // 0) * 100 | round) / 100) | tostring)
         end) +
        (if .value.dead then "  DEAD" elif (.value.enabled | not) then "  disabled" else "" end)
      ),
      (if ([.per_key[] | select(.virtual == true and .usage_unknown == true)] | length) > 0
       then "  note: own balance unavailable (/api/user/self is captcha-gated); include it with: agentrouter-proxy pool-recalibrate you <remaining>"
       else empty end)
    '
}

pool_summary() {
    # Compact pool block for status/start; silent when no pool.json.
    [[ -f "$POOL_FILE" ]] || return 0
    echo ""
    pool_status_cmd || true
}

_pool_status_from_proxy() {
    # Authoritative when the running proxy has pooling on.
    local resp has
    resp=$(curl -s --max-time 5 "$PROXY_URL/pool/status" 2>/dev/null)
    has=$(echo "$resp" | jq -r 'if (.per_key | type) == "object" and (.per_key | length) > 0 then "yes" else "no" end' 2>/dev/null)
    [[ "$has" == "yes" ]] && { echo "$resp"; return 0; }
    return 1
}

_pool_status_from_files() {
    # Works with the proxy stopped; reuses the proxy's own math. Does not force
    # POOL_ENABLED, so the reported routing state is honest.
    "$VENV_PY" -c '
import json, sys
sys.path.insert(0, sys.argv[1])
import proxy
print(json.dumps(proxy._pool_status(refresh=True)))
' "$PROXY_DIR" 2>/dev/null
}

pool_status_cmd() {
    local raw=false
    [[ "$1" == "--raw" ]] && raw=true
    command -v jq >/dev/null 2>&1 || { echo "jq is required for the pool commands."; return 1; }

    local json
    json=$(_pool_status_from_proxy) || json=$(_pool_status_from_files) || {
        echo "Could not read pool status (proxy stopped and files unreadable?)."
        return 1
    }
    if [[ -z "$json" ]]; then
        echo "No pool keys configured. Start with: agentrouter-proxy pool-add <name>"
        return 1
    fi

    if $raw; then
        echo "$json" | jq '.'
    else
        _print_pool_status "$json"
    fi
}

start_proxy() {
    if is_running; then
        echo "AgentRouter proxy is already running (PID $(cat "$PID_FILE"))."
        echo "URL: http://localhost:7187"
        return 0
    fi

    cd "$PROXY_DIR" || exit 1

    if [[ "$1" == "-d" || "$1" == "--background" ]]; then
        nohup "$START_SCRIPT" > "$LOG_FILE" 2>&1 &
        local pid=$!
        echo "$pid" > "$PID_FILE"

        sleep 1

        if is_running; then
            echo "AgentRouter proxy started in background."
            echo "PID: $pid"
            echo "URL: http://localhost:7187"
            echo "Log: $LOG_FILE"
            echo ""
            quota_report
            pool_summary
            start_tray && echo "Tray icon active in menu bar."
        else
            rm -f "$PID_FILE"
            echo "Failed to start AgentRouter proxy."
            echo "Check: $LOG_FILE"
            return 1
        fi
    else
        echo "Starting AgentRouter proxy..."
        echo "Press Ctrl+C to stop."
        quota_report
        pool_summary
        start_tray && echo "Tray icon active in menu bar."
        trap 'stop_tray; echo ""; echo "Stopped."' EXIT INT TERM
        "$START_SCRIPT"
    fi
}

stop_proxy() {
    local had_tray=false
    tray_is_running && had_tray=true

    if ! is_running; then
        echo "AgentRouter proxy is not running."
        rm -f "$PID_FILE"
        $had_tray && stop_tray
        return 0
    fi

    local pid
    pid=$(cat "$PID_FILE")

    kill "$pid" 2>/dev/null

    for _ in {1..20}; do
        if ! kill -0 "$pid" 2>/dev/null; then
            break
        fi
        sleep 0.1
    done

    if kill -0 "$pid" 2>/dev/null; then
        echo "Proxy did not stop cleanly; sending SIGKILL..."
        kill -9 "$pid" 2>/dev/null
    fi

    rm -f "$PID_FILE"
    echo "AgentRouter proxy stopped."
    $had_tray && stop_tray
}

status_proxy() {
    if is_running; then
        local pid
        pid=$(cat "$PID_FILE")
        echo "AgentRouter proxy: RUNNING"
        echo "PID: $pid"
        echo "URL: http://localhost:7187"
        echo "Log: $LOG_FILE"
        echo ""
        quota_report
        pool_summary
        if tray_is_running; then
            echo "Tray icon: active (PID $(cat "$TRAY_PID_FILE"))"
        else
            echo "Tray icon: not running"
        fi
    else
        rm -f "$PID_FILE"
        echo "AgentRouter proxy: STOPPED"
        if tray_is_running; then
            echo "Tray icon: active (orphaned, stopping)"
            stop_tray
        fi
    fi
}

case "${1:-}" in
    start)
        start_proxy "$2"
        ;;
    stop)
        stop_proxy
        ;;
    status)
        status_proxy
        ;;
    restart)
        stop_proxy
        start_proxy "$2"
        ;;
    quota)
        quota_report "$2"
        ;;
    set-cookie)
        set_cookie
        ;;
    sync-models)
        shift
        sync_models "$@"
        ;;
    pool-add)
        shift
        pool_add "$@"
        ;;
    pool-forget)
        shift
        pool_forget "$@"
        ;;
    pool-recalibrate)
        shift
        pool_recalibrate "$@"
        ;;
    pool-status)
        shift
        pool_status_cmd "$@"
        ;;
    tray-compile)
        ensure_tray_built && echo "Tray binary ready: $TRAY_BIN"
        ;;
    *)
        echo "Usage:"
        echo "  agentrouter-proxy start           Start in foreground"
        echo "  agentrouter-proxy start -d        Start in background"
        echo "  agentrouter-proxy stop            Stop the proxy"
        echo "  agentrouter-proxy status          Check whether it's running"
        echo "  agentrouter-proxy restart [-d]    Restart the proxy"
        echo "  agentrouter-proxy quota           Show remaining quota %"
        echo "  agentrouter-proxy set-cookie      Set/refresh quota credentials"
        echo "  agentrouter-proxy sync-models     Sync TUI model list from live upstream list"
        echo "  agentrouter-proxy pool-add <name>            Import an sk- key (stdin-only)"
        echo "  agentrouter-proxy pool-recalibrate <name> <usd>  Anchor a key's balance"
        echo "  agentrouter-proxy pool-forget <name>         Delete a key and disable it"
        echo "  agentrouter-proxy pool-status [--raw]        Show combined pool status"
        echo "  agentrouter-proxy tray-compile    Pre-compile tray app"
        exit 1
        ;;
esac
